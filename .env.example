# Optional. The app uses https://rpc.testnet.miden.io by default.
# VITE_MIDEN_RPC_URL=https://rpc.testnet.miden.io

# Random bridge runner. Copy this file to .env and fill in your wallet values.
# RUNS is the number of attempts; INTERVAL_SECONDS is the delay between them.
RUNS=3
INTERVAL_SECONDS=5
EPOCH_API_URL=https://testnet-dev.epochprotocol.xyz

# EVM wallet and testnet token settings
EVM_PRIVATE_KEY=0x
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_CHAIN_ID=11155111
EVM_TOKEN_ADDRESS=0x2BB4FfD7E2c6D432b697554Efd77fA13bdbefd69
EVM_TOKEN_DECIMALS=18
# Optional: defaults to the address derived from EVM_PRIVATE_KEY.
EVM_RECIPIENT_ADDRESS=

# Miden account and token settings
# Hex account ID or full mtst... wallet address.
MIDEN_ACCOUNT_ID=
# Hex encoding of AuthSecretKey.serialize() for this account's auth key.
MIDEN_AUTH_SECRET_KEY=0x
MIDEN_FAUCET_ID=0x5b043dcb48d5721106f7a1ceb2b804
MIDEN_TOKEN_DECIMALS=6
# Optional endpoint overrides; leave unset for Miden testnet defaults.
# MIDEN_RPC_URL=https://rpc.testnet.miden.io
# MIDEN_FEE_FAUCET_ID=0x4cbdcaffe75f0a317482224dae6436
